{
  "uid": "docker-infra",
  "title": "Infrastructure — Docker & PostgreSQL",
  "description": "Container CPU, memory, network, disk I/O via cAdvisor + Prometheus. PostgreSQL DB sizes and locks via postgres-exporter.",
  "tags": ["infrastructure", "docker", "postgres", "lesotho"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "panels": [

    { "id": 100, "type": "row", "title": "Overview", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 1, "type": "stat", "title": "Running Containers",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }}},
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "count(container_last_seen{name!=\"\"})", "legendFormat": "containers", "refId": "A" }]
    },
    {
      "id": 2, "type": "stat", "title": "Total Memory Used",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 8589934592 }, { "color": "red", "value": 12884901888 }
      ]}}},
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "sum(container_memory_working_set_bytes{name!=\"\"})", "legendFormat": "total", "refId": "A" }]
    },
    {
      "id": 3, "type": "stat", "title": "Total CPU Cores Used",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 4 }, { "color": "red", "value": 8 }
      ]}}},
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[2m]))", "legendFormat": "cores", "refId": "A" }]
    },
    {
      "id": 4, "type": "stat", "title": "Total Network RX Rate",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "Bps", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }}},
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "sum(rate(container_network_receive_bytes_total{name!=\"\"}[2m]))", "legendFormat": "RX", "refId": "A" }]
    },
    {
      "id": 5, "type": "stat", "title": "Network Errors",
      "description": "Dropped packets or receive/transmit errors across all containers",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 }
      ]}}},
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "sum(rate(container_network_receive_errors_total{name!=\"\"}[2m]) + rate(container_network_transmit_errors_total{name!=\"\"}[2m]))",
        "legendFormat": "errors/s", "refId": "A" }]
    },
    {
      "id": 6, "type": "stat", "title": "PostgreSQL Total DB Size",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }}},
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "sum(pg_database_size_bytes{datname!~\"template.*\"})", "legendFormat": "total", "refId": "A" }]
    },

    { "id": 101, "type": "row", "title": "CPU", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 10, "type": "timeseries", "title": "CPU Usage — Top Consumers (cores)",
      "description": "CPU seconds/s per container = effective cores used. Java services (DHIS2, HAPI, OpenSRP, OpenLMIS) dominate at startup.",
      "gridPos": { "x": 0, "y": 6, "w": 16, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3, "custom": { "lineWidth": 1, "fillOpacity": 5 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "topk(10, rate(container_cpu_usage_seconds_total{name!=\"\"}[$__rate_interval]))",
        "legendFormat": "{{name}}", "refId": "A" }]
    },
    {
      "id": 11, "type": "bargauge", "title": "CPU Now — All Containers",
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 8 },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "valueMode": "color" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1.5 }
        ]}
      }},
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "sort_desc(rate(container_cpu_usage_seconds_total{name!=\"\"}[2m]))",
        "legendFormat": "{{name}}", "refId": "A" }]
    },

    { "id": 102, "type": "row", "title": "Memory", "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 20, "type": "timeseries", "title": "Memory Working Set — Top Consumers",
      "description": "Working set = RSS + active file cache (excludes reclaimable pages). More accurate than usage_bytes for actual pressure.",
      "gridPos": { "x": 0, "y": 15, "w": 16, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 1, "fillOpacity": 5 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "topk(10, container_memory_working_set_bytes{name!=\"\"})",
        "legendFormat": "{{name}}", "refId": "A" }]
    },
    {
      "id": 21, "type": "bargauge", "title": "Memory Now — All Containers",
      "gridPos": { "x": 16, "y": 15, "w": 8, "h": 8 },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "valueMode": "color" },
      "fieldConfig": { "defaults": { "unit": "bytes",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 536870912 }, { "color": "red", "value": 1610612736 }
        ]}
      }},
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "sort_desc(container_memory_working_set_bytes{name!=\"\"})",
        "legendFormat": "{{name}}", "refId": "A" }]
    },
    {
      "id": 22, "type": "timeseries", "title": "Memory RSS vs Cache",
      "description": "RSS (anonymous memory) vs cache. High cache = filesystem-heavy workload (DHIS2 DB queries). High RSS = heap pressure.",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 6 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 1 } } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
          "expr": "sum(container_memory_rss{name!=\"\"})", "legendFormat": "RSS (heap)", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
          "expr": "sum(container_memory_cache{name!=\"\"})", "legendFormat": "Cache", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
          "expr": "sum(container_memory_swap{name!=\"\"})", "legendFormat": "Swap", "refId": "C" }
      ]
    },
    {
      "id": 23, "type": "timeseries", "title": "Memory OOM / Failures",
      "description": "Memory allocation failures — non-zero means containers are hitting memory limits",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 6 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
      }},
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "sum by (name) (rate(container_memory_failures_total{name!=\"\"}[$__rate_interval]))",
        "legendFormat": "{{name}}", "refId": "A" }]
    },

    { "id": 103, "type": "row", "title": "Network", "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 30, "type": "timeseries", "title": "Network RX Rate — Top Consumers",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 7 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 1 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "topk(8, rate(container_network_receive_bytes_total{name!=\"\"}[$__rate_interval]))",
        "legendFormat": "{{name}}", "refId": "A" }]
    },
    {
      "id": 31, "type": "timeseries", "title": "Network TX Rate — Top Consumers",
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 7 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 1 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "topk(8, rate(container_network_transmit_bytes_total{name!=\"\"}[$__rate_interval]))",
        "legendFormat": "{{name}}", "refId": "A" }]
    },
    {
      "id": 32, "type": "timeseries", "title": "Dropped Packets",
      "description": "Non-zero = network congestion or host NIC issues",
      "gridPos": { "x": 0, "y": 37, "w": 12, "h": 5 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "pps", "custom": { "lineWidth": 2 },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
      }},
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
          "expr": "sum by (name) (rate(container_network_receive_packets_dropped_total{name!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{name}} RX drop", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
          "expr": "sum by (name) (rate(container_network_transmit_errors_total{name!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{name}} TX err", "refId": "B" }
      ]
    },
    {
      "id": 33, "type": "timeseries", "title": "Total Network Throughput",
      "gridPos": { "x": 12, "y": 37, "w": 12, "h": 5 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2, "fillOpacity": 8 } } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
          "expr": "sum(rate(container_network_receive_bytes_total{name!=\"\"}[$__rate_interval]))",
          "legendFormat": "total RX", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
          "expr": "sum(rate(container_network_transmit_bytes_total{name!=\"\"}[$__rate_interval]))",
          "legendFormat": "total TX", "refId": "B" }
      ]
    },

    { "id": 104, "type": "row", "title": "Disk I/O", "gridPos": { "x": 0, "y": 42, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 40, "type": "timeseries", "title": "Disk Read Rate — Top Consumers",
      "gridPos": { "x": 0, "y": 43, "w": 12, "h": 7 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 1 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "topk(8, rate(container_fs_reads_total{name!=\"\"}[$__rate_interval]))",
        "legendFormat": "{{name}}", "refId": "A" }]
    },
    {
      "id": 41, "type": "timeseries", "title": "Disk Write Rate — Top Consumers",
      "gridPos": { "x": 12, "y": 43, "w": 12, "h": 7 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 1 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "topk(8, rate(container_fs_writes_total{name!=\"\"}[$__rate_interval]))",
        "legendFormat": "{{name}}", "refId": "A" }]
    },
    {
      "id": 42, "type": "bargauge", "title": "Container Filesystem Usage",
      "description": "Disk space used by each container's writable layer (excludes shared image layers)",
      "gridPos": { "x": 0, "y": 50, "w": 12, "h": 7 },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "valueMode": "color" },
      "fieldConfig": { "defaults": { "unit": "bytes",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 1073741824 }, { "color": "red", "value": 5368709120 }
        ]}
      }},
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "sort_desc(container_fs_usage_bytes{name!=\"\"})",
        "legendFormat": "{{name}}", "refId": "A" }]
    },
    {
      "id": 43, "type": "timeseries", "title": "Disk I/O Time (utilisation)",
      "description": "Time spent doing I/O — sustained high values indicate disk is saturated",
      "gridPos": { "x": 12, "y": 50, "w": 12, "h": 7 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 1 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "topk(6, rate(container_fs_io_time_seconds_total{name!=\"\"}[$__rate_interval]))",
        "legendFormat": "{{name}}", "refId": "A" }]
    },

    { "id": 105, "type": "row", "title": "PostgreSQL", "gridPos": { "x": 0, "y": 57, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 50, "type": "bargauge", "title": "Database Sizes",
      "gridPos": { "x": 0, "y": 58, "w": 8, "h": 8 },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "valueMode": "color" },
      "fieldConfig": { "defaults": { "unit": "bytes",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 104857600 }, { "color": "red", "value": 524288000 }
        ]}
      }},
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "sort_desc(pg_database_size_bytes{datname!~\"template.*|postgres\"})",
        "legendFormat": "{{datname}}", "refId": "A" }]
    },
    {
      "id": 51, "type": "timeseries", "title": "Database Size Growth",
      "description": "Watch for sudden growth in dhis2 or openlmis_* DBs — indicates heavy writes or audit table bloat",
      "gridPos": { "x": 8, "y": 58, "w": 16, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "pg_database_size_bytes{datname!~\"template.*|postgres\"}",
        "legendFormat": "{{datname}}", "refId": "A" }]
    },
    {
      "id": 52, "type": "timeseries", "title": "PostgreSQL Locks",
      "description": "Lock contention — spikes correlate with heavy concurrent writes (seed.sh, mediator fan-out burst)",
      "gridPos": { "x": 0, "y": 66, "w": 12, "h": 6 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "expr": "sum by (mode) (pg_locks_count)",
        "legendFormat": "{{mode}}", "refId": "A" }]
    },
    {
      "id": 53, "type": "timeseries", "title": "PostgreSQL Up / Scrape Health",
      "description": "1 = exporter can reach postgres; 0 = postgres down or auth failed",
      "gridPos": { "x": 12, "y": 66, "w": 12, "h": 6 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
        "custom": { "lineWidth": 2 }
      }},
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
          "expr": "pg_up", "legendFormat": "pg_up", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
          "expr": "pg_exporter_last_scrape_error", "legendFormat": "scrape error", "refId": "B" }
      ]
    }
  ],
  "templating": {
    "list": [
      { "hide": 2, "name": "prometheus_ds", "query": "prometheus", "refresh": 1, "type": "datasource" }
    ]
  }
}

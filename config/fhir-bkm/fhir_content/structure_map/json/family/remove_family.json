{
  "resourceType": "StructureMap",
  "id": "b16b2831-9fe7-43c3-9440-8860b8ca9f79",
  "text": {
    "status": "additional",
    "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><pre>map &quot;https://fhir.labs.smartregister.org/fhir/StructureMap/b16b2831-9fe7-43c3-9440-8860b8ca9f79&quot; = 'Remove Family'\n\nuses &quot;http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse&quot; as source\nuses &quot;http://hl7.org/fhir/StructureDefinition/Bundle&quot; as target\n\ngroup ecbisRemoveFamily(source questionnaireResponse : QuestionnaireResponse, target bundle: Bundle) {\n    questionnaireResponse -&gt; bundle.id = uuid() &quot;rule_bundle_id&quot;;\n    questionnaireResponse -&gt; bundle.type = 'collection' &quot;rule_bundle_type&quot;;\n    questionnaireResponse then extractEncounter(questionnaireResponse, bundle) &quot;rule_bundle_entry_ext_enc&quot;;\n}\n\ngroup extractEncounter(source questionnaireResponse: QuestionnaireResponse, target bundle: Bundle) {\n    questionnaireResponse-&gt;bundle.entry as entry,\n    entry.resource = create(&quot;Encounter&quot;) as encounter then {\n        questionnaireResponse-&gt;encounter.id = uuid() &quot;rule_enc_id&quot;;\n        questionnaireResponse-&gt;encounter.status = &quot;finished&quot; &quot;rule_enc_status&quot;;\n        questionnaireResponse-&gt;encounter.class = c(&quot;http://terminology.hl7.org/CodeSystem/v3-ActCode&quot;, &quot;HH&quot;,&quot;home health&quot;) &quot;rule_enc_class&quot;;\n        questionnaireResponse-&gt;encounter.serviceType = cc(&quot;http://terminology.hl7.org/CodeSystem/service-type&quot;, &quot;85&quot;,&quot;Death Service Information&quot;) &quot;rule_enc_ser_type&quot;;\n        questionnaireResponse -&gt; encounter.type = create('CodeableConcept') as concept then {\n            questionnaireResponse -&gt; concept.coding = c(&quot;https://smartregister.org/&quot;, &quot;remove_family&quot;) as coding then {\n                questionnaireResponse -&gt; coding.display = &quot;Remove family&quot; &quot;rule_display&quot;;\n            } &quot;rule_en_coding&quot;;\n            questionnaireResponse -&gt; concept.text = &quot;Remove family&quot; &quot;rule_text&quot;;\n        } &quot;rule_en_type&quot;;\n        questionnaireResponse -&gt; encounter.priority = create('CodeableConcept') as priority then {\n            questionnaireResponse -&gt; priority.coding = c(&quot;http://terminology.hl7.org/ValueSet/v3-ActPriority&quot;, &quot;EL&quot;) as priorityCoding then {\n                questionnaireResponse -&gt; priorityCoding.display = &quot;Elective&quot; &quot;rule_en_cod_disp&quot;;\n            } &quot;rule_en_cc_cod&quot;;\n            questionnaireResponse -&gt; priority.text = &quot;Elective&quot; &quot;rule_en_prio_text&quot;;\n        } &quot;rule_priority&quot;;\n        questionnaireResponse -&gt; encounter.subject = create('Reference') as ref then {\n            questionnaireResponse-&gt; ref.reference = evaluate(questionnaireResponse, 'Patient/' + $this.item.where(linkId = &quot;261fdbe6-e0aa-48e5-824b-55314b60d8d6&quot;).answer.value) &quot;rule_item_observation_reference&quot;;\n        } &quot;rule_observation_reference&quot;;\n        questionnaireResponse -&gt; encounter.period = create('Period') as period then {\n            questionnaireResponse -&gt; period.start = evaluate(questionnaireResponse, now()) &quot;rule_period_start&quot;;\n            questionnaireResponse -&gt; period.end = evaluate(questionnaireResponse, now()) &quot;rule_period_end&quot;;\n        } &quot;rule_period&quot;;\n        questionnaireResponse -&gt; encounter.reasonCode = create('CodeableConcept') as reason then {\n            questionnaireResponse -&gt; reason.text = &quot;Remove family&quot; &quot;rule_en_text&quot;;\n            questionnaireResponse -&gt; reason.coding = c(&quot;https://smartregister.org/&quot;, &quot;remove_family&quot;) &quot;rule_rea_cd&quot;;\n        } &quot;rule_en_reason&quot;;\n\n        questionnaireResponse then extractReasonForRemoval(questionnaireResponse, bundle, encounter) &quot;rule_enc_ext_observation&quot;;\n        questionnaireResponse then setHouseholdActiveAsFalseAndDelete(questionnaireResponse, bundle) &quot;rule_enc_set_household_active_as_false&quot;;\n    } &quot;rule_bundle_entry_enc&quot;;\n}\n\ngroup extractReasonForRemoval(source questionnaireResponse: QuestionnaireResponse, target bundle: Bundle, target encounter: Encounter) {\n    questionnaireResponse.item as questionnaireItem where(linkId = &quot;c072659f-33a1-4ca3-86bb-073afad8290e&quot;) then {\n        questionnaireResponse-&gt;bundle.entry as entry, entry.resource = create(&quot;Observation&quot;) as observation then {\n            questionnaireResponse -&gt; observation.code = cc(&quot;https://smartregister.org/&quot;, &quot;remove-group-reason&quot;, &quot;Family Removal Reason&quot;) &quot;rule_item_removal_reason_observation_code&quot;;\n            questionnaireResponse -&gt; observation.value = create(&quot;CodeableConcept&quot;)as codeableConcept then {\n                questionnaireResponse -&gt; codeableConcept.coding = evaluate(questionnaireItem, $this.answer.value.code) &quot;rule_item_removal_reason_observation_value_cc_coding&quot;;\n                questionnaireResponse -&gt; codeableConcept.text = evaluate(questionnaireResponse, $this.answer.value.display) &quot;rule_item_removal_reason_observation_cc_display&quot;;\n            } &quot;rule_item_removal_reason_observation_value&quot;;\n\n            questionnaireResponse then extractObservations(questionnaireResponse, bundle, encounter, observation) &quot;rule_item_observation_exttraction&quot;;\n\n            questionnaireItem where(answer.value.code = 'moved-away') then extractMoveAwayDate(questionnaireResponse, bundle, encounter) &quot;rule_item_extract_remove_date&quot;;\n            questionnaireItem where(answer.value.code = 'died') then extractDeathDate(questionnaireResponse, bundle, encounter) &quot;rule_item_extract_death_date&quot;;\n            questionnaireItem where(answer.value.code = 'other') then extractOtherIndicateReason(questionnaireResponse, bundle, encounter) &quot;rule_item_extract_other_reason_indicate&quot;;\n        } &quot;rule_observation&quot;;\n    } &quot;rule_item_removal_reason&quot;;\n}\n\ngroup extractMoveAwayDate(source questionnaireResponse: QuestionnaireResponse, target bundle: Bundle, target encounter: Encounter) {\n    questionnaireResponse.item as questionnaireItem where(linkId = &quot;859f0b8e-80b6-4a15-f6a5-b1bec78d928c&quot;) then {\n        questionnaireResponse-&gt;bundle.entry as entry, entry.resource = create(&quot;Observation&quot;) as observation then {\n            questionnaireResponse -&gt; observation.code = cc(&quot;https://smartregister.org/&quot;, &quot;removal-reason-date&quot;, &quot;Family Removal Date&quot;) &quot;rule_item_date_reason_moved_away_observation_code&quot;;\n            questionnaireResponse -&gt; observation.value = evaluate(questionnaireItem, $this.answer.value.toString() + 'T00:00:00.00Z') &quot;rule_item_reason_moved_away_date_observation_value&quot;;\n\n            questionnaireResponse then extractObservations(questionnaireResponse, bundle, encounter, observation) &quot;rule_item_observation_exttraction&quot;;\n        } &quot;rule_observation&quot;;\n    } &quot;rule_item_reason_moved_away&quot;;\n}\n\ngroup extractDeathDate(source questionnaireResponse: QuestionnaireResponse, target bundle: Bundle, target encounter: Encounter) {\n    questionnaireResponse.item as questionnaireItem where(linkId = &quot;4c495cf6-4ffa-4b14-8998-5f51bd00bce5&quot;) then {\n        questionnaireResponse-&gt;bundle.entry as entry, entry.resource = create(&quot;Observation&quot;) as observation then {\n            questionnaireResponse -&gt; observation.code = cc(&quot;https://smartregister.org/&quot;, &quot;removal-reason-date&quot;, &quot;Family Removal Date&quot;) &quot;rule_item_date_reason_moved_away_observation_code&quot;;\n            questionnaireResponse -&gt; observation.value = evaluate(questionnaireItem, $this.answer.value.toString() + 'T00:00:00.00Z') &quot;rule_item_reason_moved_away_date_observation_value&quot;;\n\n            questionnaireResponse then extractObservations(questionnaireResponse, bundle, encounter, observation) &quot;rule_item_observation_exttraction&quot;;\n        } &quot;rule_observation&quot;;\n    } &quot;rule_item_reason_moved_away&quot;;\n}\n\ngroup extractOtherIndicateReason(source questionnaireResponse: QuestionnaireResponse, target bundle: Bundle, target encounter: Encounter) {\n    questionnaireResponse.item as questionnaireItem where(linkId = &quot;b6a432a9-7026-4543-9f56-fc404e1d42c6&quot;) then {\n        questionnaireResponse-&gt;bundle.entry as entry, entry.resource = create(&quot;Observation&quot;) as observation then {\n            questionnaireResponse -&gt; observation.value = create(&quot;CodeableConcept&quot;)as codeableConcept then {\n                questionnaireResponse -&gt; observation.code = cc(&quot;https://smartregister.org/&quot;, &quot;group_other-remove-reason&quot;, &quot;Other Family Removal Reason&quot;) &quot;rule_item_other_indicate_reason_observation_code&quot;;\n                questionnaireResponse -&gt; codeableConcept.coding = evaluate(questionnaireItem, $this.answer.value.code) &quot;rule_item_other_indicate_reason_observation_value_cc_coding&quot;;\n                questionnaireResponse -&gt; codeableConcept.text = 'Removal other reason' &quot;rule_item_other_indicate_reason_observation_cc_display&quot;;\n            } &quot;rule_item_other_indicate_reason_observation_value&quot;;\n            questionnaireResponse then extractObservations(questionnaireResponse, bundle, encounter, observation) &quot;rule_item_observation_exttraction&quot;;\n        } &quot;rule_observation&quot;;\n    } &quot;rule_item_other_indicate_reason&quot;;\n}\n\ngroup extractObservations(source questionnaireResponse: QuestionnaireResponse, target bundle: Bundle, target encounter: Encounter,  target observation: Observation) {\n    questionnaireResponse-&gt;observation.id = uuid() &quot;rule_observation_id&quot;;\n    questionnaireResponse-&gt;observation.subject = create(&quot;Reference&quot;)as ref then {\n        questionnaireResponse-&gt;ref.reference = evaluate(questionnaireResponse, 'Patient/' + $this.item.where(linkId = &quot;261fdbe6-e0aa-48e5-824b-55314b60d8d6&quot;).answer.value) &quot;rule_item_observation_reference&quot;;\n    } &quot;rule_observation_reference&quot;;\n    questionnaireResponse-&gt;observation.encounter = reference(encounter) &quot;rule_observation_encounter&quot;;\n    questionnaireResponse-&gt;observation.category = cc(&quot;http://terminology.hl7.org/CodeSystem/observationervation-category&quot;, &quot;social-history&quot;, &quot;Social History&quot;) &quot;rule_observation_catergory&quot;;\n    questionnaireResponse-&gt;observation.effective = evaluate(questionnaireResponse, now()) &quot;rule_observation_effective&quot;;\n    questionnaireResponse -&gt; observation.status = &quot;final&quot; &quot;rule_item_removal_reason_observation_status&quot;;\n}\n\ngroup setHouseholdActiveAsFalseAndDelete(source questionnaireResponse: QuestionnaireResponse, target bundle: Bundle) {\n    questionnaireResponse.item as questionnaireItem where(linkId = &quot;261fdbe6-e0aa-48e5-824b-55314b60d8d6&quot;) then {\n        questionnaireResponse-&gt;bundle.entry as entry, entry.resource = create(&quot;Group&quot;) as household then {\n            questionnaireResponse-&gt;household.id = create(&quot;id&quot;) as household_id then {\n                questionnaireResponse-&gt;household_id.value = evaluate(questionnaireItem, $this.answer.value) &quot;rule_item_group_set_pat_id&quot;;\n            } &quot;rule_item_group_create_pat_id&quot;;\n            questionnaireResponse -&gt; household.active = false &quot;rule_item_group_active&quot;;\n            questionnaireResponse -&gt; household.characteristic = create('Group_Characteristic') as excludeFamily then {\n                questionnaireResponse -&gt; excludeFamily.exclude = true &quot;rule_exclude_group_true&quot;;\n            } &quot;rule_group_char&quot;;\n            questionnaireResponse -&gt; household.characteristic = create('Group_Characteristic') as familyCharacteristic then {\n                questionnaireResponse -&gt; familyCharacteristic.code = create('CodeableConcept') as familyCharacteristicCode then{\n                    questionnaireResponse -&gt; familyCharacteristicCode.coding = c(&quot;https://smartregister.org/&quot;, &quot;inactive&quot;) as coding then {\n                       questionnaireResponse -&gt; coding.display = 'inactive' &quot;rule_cod_disp&quot;;\n                    } &quot;rule_grp_vcode&quot;;\n               } &quot;rule_group_char_code&quot;;\n            } &quot;rule_group_char&quot;;\n        } &quot;rule_item_group&quot;;\n    } &quot;rule_item_group_id&quot;;\n}\n</pre></div>"

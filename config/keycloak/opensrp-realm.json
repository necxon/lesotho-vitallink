{
  "id": "opensrp",
  "realm": "opensrp",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "opensrp-web",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:9901/*"
      ],
      "webOrigins": [
        "http://localhost:9901"
      ]
    },
    {
      "clientId": "bkm-mediator",
      "enabled": true,
      "publicClient": false,
      "secret": "mediator-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "clientAuthenticatorType": "client-secret"
    }
  ],
  "roles": {
    "realm": [
      { "name": "OPENMRS",    "description": "OpenSRP REST API access" },
      { "name": "ALL_EVENTS", "description": "OpenSRP event getAll access" },
      { "name": "MANAGE_Patient",                "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Practitioner",           "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_PractitionerRole",       "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Group",                  "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Organization",           "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_OrganizationAffiliation","description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_HealthcareService",      "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Location",               "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Observation",            "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_QuestionnaireResponse",  "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_CareTeam",               "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_PlanDefinition",         "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Questionnaire",          "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_PractitionerDetail",     "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_List",                   "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Binary",                 "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Condition",              "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Task",                   "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Immunization",           "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Encounter",              "description": "opensrp-web FHIR permission" },
      { "name": "MANAGE_Flag",                   "description": "opensrp-web FHIR permission" }
    ]
  },
  "users": [
    {
      "username": "opensrp-admin",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "realmRoles": [
        "OPENMRS", "ALL_EVENTS",
        "MANAGE_Patient", "MANAGE_Practitioner", "MANAGE_PractitionerRole",
        "MANAGE_Group", "MANAGE_Organization", "MANAGE_OrganizationAffiliation",
        "MANAGE_HealthcareService", "MANAGE_Location", "MANAGE_Observation",
        "MANAGE_QuestionnaireResponse", "MANAGE_CareTeam", "MANAGE_PlanDefinition",
        "MANAGE_Questionnaire", "MANAGE_PractitionerDetail", "MANAGE_List",
        "MANAGE_Binary", "MANAGE_Condition", "MANAGE_Task", "MANAGE_Immunization",
        "MANAGE_Encounter", "MANAGE_Flag"
      ],
      "clientRoles": {
        "realm-management": ["realm-admin"]
      }
    }
  ]
}

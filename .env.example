# =============================================================================
# .env — secrets for the Lesotho stack. COPY to `.env`, fill with REAL values.
# `.env` is gitignored — never commit it. Keep the real values in your team
# password manager (1Password / Bitwarden / Vault).
#
# docker-compose auto-loads `.env` from the repo root. Any var left unset falls
# back to the (test/demo) default in docker-compose.yml, so the test box works
# without this file — but PRODUCTION should set all of these to fresh secrets.
#
#   cp .env.example .env  &&  edit .env  &&  docker compose up -d
# =============================================================================

# Shared PostgreSQL password — used by Postgres, Keycloak DB, HAPI FHIR, mediator,
# and postgres-exporter (they MUST all match). If you change it, also update:
#   config/dhis.conf, config/opensrp/context.xml, config/initdb/01-md5-auth.sql
# (those configs are read by services that don't use this env var) and run an
# `ALTER USER admin WITH PASSWORD ...` on the live DB (or wipe the postgres volume).
PG_PASSWORD=change-me-postgres

# Keycloak master-realm admin password. Also pass to seeding: KC_ADMIN_PASSWORD=...
KC_ADMIN_PASSWORD=change-me-kc-admin

# Grafana admin password (only applied on a FRESH grafana volume; on an existing
# volume reset via the API — see deploy/README.md).
GRAFANA_PASSWORD=change-me-grafana

# Mediator → upstream service credentials. Must match the actual app users:
#   OPENHIM_PASS  → OpenHIM root@openhim.org (also set in Mongo — see deploy/README)
#   DHIS2_PASS    → DHIS2 'admin' (DB-baked; change via DHIS2 API)
#   OPENLMIS_PASS → OpenLMIS 'admin' (DB-baked; change via OpenLMIS API)
OPENHIM_PASS=password
DHIS2_PASS=district
OPENLMIS_PASS=password

# Seed password for the generated Keycloak facility users (coordinators/VHWs).
# Injected at reseed time by scripts/reseed_mafeteng.sh; gen_mafeteng_configs.py also
# reads it. The repo's JSON carries only the placeholder 'changeme' — set a real value here.
SEED_USER_PASSWORD=change-me-seed-users

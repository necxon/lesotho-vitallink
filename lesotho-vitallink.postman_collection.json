        },

        {
          "name": "Analytics — stock dispensed pivot",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{dhis2}}/api/analytics?dimension=dx:ujPSJuS9pph&dimension=pe:LAST_12_MONTHS&dimension=ou:dwx1Yz4BwNX",
              "query": [
                { "key": "dimension", "value": "dx:ujPSJuS9pph" },
                { "key": "dimension", "value": "pe:LAST_12_MONTHS" },
                { "key": "dimension", "value": "ou:dwx1Yz4BwNX" }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin" },
                { "key": "password", "value": "district" }
              ]
            }

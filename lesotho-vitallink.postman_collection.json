      "item": [

        {
          "name": "Token — opensrp-admin password grant",
          "request": {
            "method": "POST",
            "url": "{{keycloak}}/realms/opensrp/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type",    "value": "password" },

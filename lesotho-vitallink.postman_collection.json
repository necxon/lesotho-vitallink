      ]
    },

    {
      "name": "8. OpenLMIS (:8082)",
      "item": [

        {
          "name": "Auth — get token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('lmis_token', json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{openlmis}}/api/oauth/token?grant_type=password",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "user-client" },
                { "key": "password", "value": "changeme" }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "admin" },
                { "key": "password", "value": "password" }
              ]
            },
            "description": "Fetches an OpenLMIS user token. Auto-saves to {{lmis_token}} collection variable."
          }
        },

        {
          "name": "Stock Cards — SOH summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{openlmis}}/api/stockCardSummaries?facility={{facility_id}}&program={{program_id}}&orderable={{orderable_id}}",
              "query": [
                { "key": "facility",   "value": "{{facility_id}}" },
                { "key": "program",    "value": "{{program_id}}" },
                { "key": "orderable",  "value": "{{orderable_id}}", "description": "Optional — omit to see all orderables" }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{lmis_token}}" }]
            }
          }
        },

        {
          "name": "Stock Events — dispense (DEBIT)",
          "request": {
            "method": "POST",
            "url": "{{openlmis}}/api/stockEvents",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{lmis_token}}" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"programId\": \"{{program_id}}\",\n  \"facilityId\": \"{{facility_id}}\",\n  \"signature\": \"Postman\",\n  \"lineItems\": [{\n    \"orderableId\": \"{{orderable_id}}\",\n    \"quantity\": 6,\n    \"occurredDate\": \"2026-05-17\",\n    \"destinationFreeText\": \"Patient/patient-001\",\n    \"reasonId\": \"b5c27da7-bdda-4790-925a-9484c5dfb594\"\n  }]\n}"
            },
            "description": "Direct stock DEBIT (Consumed/Dispensed reason). Usually done via mediator, not directly."
          }
        },

        {
          "name": "Facilities — list",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{openlmis}}/api/facilities?page=0&size=10",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{lmis_token}}" }]
            }
          }
        },

        {
          "name": "Orderables — list",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{openlmis}}/api/orderables?page=0&size=20",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{lmis_token}}" }]
            }
          }
        }
      ]
    },


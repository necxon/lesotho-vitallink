            "url": {
              "raw": "{{dhis2}}/api/dataValues?de=ujPSJuS9pph&ou=dwx1Yz4BwNX&pe=LAST_12_MONTHS",
              "query": [
                { "key": "de", "value": "ujPSJuS9pph", "description": "Stock Dispensed AL 20/120mg" },
                { "key": "ou", "value": "dwx1Yz4BwNX", "description": "Maseru District Clinic A" },
                { "key": "pe", "value": "LAST_12_MONTHS" }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [

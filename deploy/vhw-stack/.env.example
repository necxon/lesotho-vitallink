# Copy to .env and fill in. .env is gitignored - never commit it.

# ── Public hostnames (nginx on the proxy host routes these to this server) ──
# While this host is being prepared:        at cutover to production:
#   API_HOST=app.vhw.gov.ls                   API_HOST=vhw.gov.ls
#   AUTH_HOST=app.vhw.gov.ls                  AUTH_HOST=vhw.gov.ls
#   WEB_HOST=web.vhw.gov.ls                   WEB_HOST=training.vhw.gov.ls
API_HOST=app.vhw.gov.ls
AUTH_HOST=app.vhw.gov.ls
WEB_HOST=web.vhw.gov.ls

# ── Versions: keep equal to amoh255fhir001 until deliberately upgraded ──────
HAPI_VERSION=v8.8.0-1
KEYCLOAK_VERSION=22.0.5
GATEWAY_VERSION=v3.2.0
FHIR_WEB_VERSION=v3.3.2

# ── HAPI ─────────────────────────────────────────────────────────────────────
HAPI_DB_NAME=hapidata
HAPI_DB_USER=hapi
HAPI_DB_PASSWORD=
# Quoted: the scripts also read this file with the shell.
HAPI_JAVA_OPTS="-Xms3g -Xmx8g -Duser.timezone=UTC"

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_REALM=opensrp
KC_DB_USER=keycloak
KC_DB_PASSWORD=
KC_ADMIN=admin
KC_ADMIN_PASSWORD=

# ── fhir-web ─────────────────────────────────────────────────────────────────
# Secret of the fhir-web client in the opensrp realm. A realm export masks it,
# so regenerate it in the admin console after import and paste it here.
WEB_KC_CLIENT_SECRET=
# Any long random string: openssl rand -hex 32
WEB_SESSION_SECRET=
# Same values as amoh255fhir001: the root Location and the commodity List.
ROOT_LOCATION=6b79be92-24b1-405a-acc4-be66fbadcfe7
COMMODITY_LIST=ea15c35a-8e8c-47ce-8122-c347cefa1b4a

# Copy to .env (chmod 600) and fill in. Never commit .env.
SUPERSET_VERSION=6.1.0
SUPERSET_BIND=192.0.2.132:18088

# New random key (README step 2 fills it in). Signs logins and encrypts stored
# connection passwords; must stay secret and must not be a published example key.
SUPERSET_SECRET_KEY=
# The CURRENT Superset's key, only for the one-off take-over (init re-encrypts the
# copied connections with the new key). Empty it after init has run.
SUPERSET_PREVIOUS_SECRET_KEY=

# Metadata database inside this install (any values; the password is local to it)
DATABASE_DB=superset
DATABASE_USER=superset
DATABASE_PASSWORD=

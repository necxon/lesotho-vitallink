# Preprod environment on amoh255bkmnec001 (192.0.2.132), next to the VitalLink
# stack that already runs there. Copy to .env and fill in the empty values
# (scripts/init_env.sh generates the passwords). .env is gitignored.

# Separate project, containers and volumes from any other stack on the host
COMPOSE_PROJECT_NAME=vhw-preprod
# Also start the VitalLink web portal (form and phone-menu builder)
COMPOSE_PROFILES=builder

# Public hostnames (nginx on 192.0.2.61 routes them to 192.0.2.132)
API_HOST=preprod-app.vhw.gov.ls
AUTH_HOST=preprod-app.vhw.gov.ls
WEB_HOST=preprod-web.vhw.gov.ls

# Host ports: the VitalLink stack uses 3000, 8079-8083 and 9900-9902 here.
# Only nginx on 192.0.2.61 needs to reach the 192.0.2.132 ones.
HAPI_BIND=127.0.0.1:18180
GATEWAY_BIND=192.0.2.132:18181
KEYCLOAK_BIND=192.0.2.132:18182
WEB_BIND=192.0.2.132:18300
BUILDER_BIND=192.0.2.132:18902

# VitalLink web: lesotho-vitallink checkout with the builder (branch feat/phone-menu-builder)
BKM_WEB_SRC=/opt/lesotho-vitallink/bkm-web
BKM_WEB_CONFIG=./bkm-web/config.preprod.js

# Versions: same as test and production
HAPI_VERSION=v8.8.0-1
KEYCLOAK_VERSION=22.0.5
GATEWAY_VERSION=v3.2.0
FHIR_WEB_VERSION=v3.3.2

# HAPI
HAPI_DB_NAME=hapidata
HAPI_DB_USER=hapi
HAPI_DB_PASSWORD=
# Smaller than test
HAPI_JAVA_OPTS="-Xms1g -Xmx4g -Duser.timezone=UTC"

# Keycloak
KEYCLOAK_REALM=opensrp
KC_DB_USER=keycloak
KC_DB_PASSWORD=
KC_ADMIN=admin
KC_ADMIN_PASSWORD=

# fhir-web (secret of the fhir-web client in the preprod realm; set after import)
WEB_KC_CLIENT_SECRET=
WEB_SESSION_SECRET=
ROOT_LOCATION=6b79be92-24b1-405a-acc4-be66fbadcfe7
COMMODITY_LIST=ea15c35a-8e8c-47ce-8122-c347cefa1b4a
